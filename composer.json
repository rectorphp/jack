{
    "name": "rector/jack",
    "description": "Jack helps you incrementally update your `composer.json` dependencies, ensuring your project stays current without the chaos of outdated packages",
    "license": "MIT",
    "bin": [
        "bin/jack"
    ],
    "require": {
        "php": ">=7.4",
        "composer/semver": "^3.5",
        "entropy/entropy": "^0.4.17",
        "symfony/polyfill-php80": "^1.31",
        "symfony/process": "^5.4 || ^6.4 || ^7.0 || ^8.1"
    },
    "require-dev": {
        "symplify/easy-coding-standard": "^13.3",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "^2.6",
        "rector/swiss-knife": "^2.6",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symplify/phpstan-rules": "^14.17",
        "tomasvotruba/class-leak": "^2.3",
        "tracy/tracy": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "Rector\\Jack\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rector\\Jack\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": false,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "check-cs": "vendor/bin/ecs check --ansi",
        "fix-cs": "vendor/bin/ecs check --fix --ansi",
        "phpstan": "vendor/bin/phpstan analyse --ansi",
        "rector": "vendor/bin/rector process --ansi"
    }
}
